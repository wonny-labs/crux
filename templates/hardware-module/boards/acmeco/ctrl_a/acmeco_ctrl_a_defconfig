CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_GPIO=y
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# The template carries no flash configuration block and no device
# configuration data, so its image does not boot. A real board adds both to
# this directory, checked against its own flash and memory parts, and removes
# the two lines below. Zephyr's boards/pjrc/teensy4 shows a board directory
# that carries its own flash configuration block.
CONFIG_NXP_IMXRT_BOOT_HEADER=n
CONFIG_DEVICE_CONFIGURATION_DATA=n
