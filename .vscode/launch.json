{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Board: Flash and run to main",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi/zephyr/zephyr.elf",
      "device": "MIMXRT1062xxx6A",
      "interface": "swd",
      "serverArgs": [
        "-speed",
        "auto"
      ],
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
      "preLaunchTask": "Build firmware",
      "runToEntryPoint": "main"
    },
    {
      "name": "Board: Attach (no reset)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi/zephyr/zephyr.elf",
      "device": "MIMXRT1062xxx6A",
      "interface": "swd",
      "serverArgs": [
        "-speed",
        "auto"
      ],
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
    },
    {
      "name": "Board: Attach to a host GDB server",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "gdbTarget": "host.docker.internal:2331",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi/zephyr/zephyr.elf",
      "device": "MIMXRT1062xxx6A",
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
    }
  ]
}
