{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Board: Debug",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi--current/zephyr/zephyr.elf",
      "device": "MIMXRT1062xxx6A",
      "interface": "swd",
      "serverArgs": [
        "-speed",
        "auto"
      ],
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
      "preLaunchTask": "Board: Check probe and build",
      "runToEntryPoint": "main"
    },
    {
      "name": "Board: Attach",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "jlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi--current/zephyr/zephyr.elf",
      "device": "MIMXRT1062xxx6A",
      "interface": "swd",
      "serverArgs": [
        "-speed",
        "auto"
      ],
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
      "preLaunchTask": "Board: Check probe"
    },
    {
      "name": "Board: Attach (external)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "gdbTarget": "host.docker.internal:2331",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi--current/zephyr/zephyr.elf",
      "device": "MIMXRT1062xxx6A",
      "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
    },
    {
      "name": "native_sim: Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/native_sim/zephyr/zephyr.exe",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "unknownBreakpointHandling": "stop",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Pass -uart_stdinout if the program accepts it; stop at the application main",
          "text": "source ${workspaceFolder}/.vscode/native_sim_debug.py",
          "ignoreFailures": false
        }
      ],
      "preLaunchTask": "native_sim: Build"
    }
  ]
}
