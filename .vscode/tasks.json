{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Board: Build",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi",
        "--app",
        "${input:sample}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board: Flash",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "grep -qsx 1366 /sys/bus/usb/devices/*/idVendor || { echo 'No J-Link probe found. Attach it to WSL2: usbipd attach --wsl --busid <BUSID> (Getting started, section 7).' >&2; exit 1; }; exec west flash -d build/zephyr/mimxrt1060_evk_B_qspi--current -r jlink"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board: Clean",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf -- build/zephyr/mimxrt1060_evk_B_qspi build/zephyr/mimxrt1060_evk_B_qspi--*"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "native_sim: Build",
      "type": "process",
      "command": "west",
      "args": [
        "build",
        "-p",
        "auto",
        "-b",
        "native_sim/native/64",
        "-d",
        "build/native_sim",
        "${input:sample}",
        "--",
        "-DCONFIG_NO_OPTIMIZATIONS=y"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "native_sim: Run",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "if [ ! -f build/native_sim/CMakeCache.txt ]; then echo 'Run native_sim: Build first.' >&2; exit 1; fi; west build -p never -d build/native_sim || exit; exe=build/native_sim/zephyr/zephyr.exe; if \"$exe\" -h 2>&1 | grep -q -- -uart_stdinout; then exec \"$exe\" -uart_stdinout; fi; exec \"$exe\""
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "native_sim: Clean",
      "type": "process",
      "command": "rm",
      "args": [
        "-rf",
        "--",
        "build/native_sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board: Check probe",
      "hide": true,
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "grep -qsx 1366 /sys/bus/usb/devices/*/idVendor || { echo 'No J-Link probe found. Attach it to WSL2: usbipd attach --wsl --busid <BUSID> (Getting started, section 7).' >&2; exit 1; }"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Board: Check probe and build",
      "hide": true,
      "dependsOn": [
        "Board: Check probe",
        "Board: Build"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "sample",
      "type": "promptString",
      "description": "Sample directory, relative to the repository",
      "default": "samples/hello_crux"
    }
  ]
}
