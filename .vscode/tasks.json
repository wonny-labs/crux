{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Board: Build",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi",
        "--app",
        "${input:sample}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board: Flash",
      "type": "process",
      "command": "west",
      "args": [
        "flash",
        "-d",
        "build/zephyr/mimxrt1060_evk_B_qspi--current",
        "-r",
        "jlink"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board: Clean",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf -- build/zephyr/mimxrt1060_evk_B_qspi build/zephyr/mimxrt1060_evk_B_qspi--*"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "native_sim: Build",
      "type": "process",
      "command": "west",
      "args": [
        "build",
        "-p",
        "auto",
        "-b",
        "native_sim/native/64",
        "-d",
        "build/native_sim",
        "${input:sample}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "native_sim: Run",
      "type": "process",
      "command": "${workspaceFolder}/build/native_sim/zephyr/zephyr.exe",
      "args": [
        "-uart_stdinout"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "native_sim: Clean",
      "type": "process",
      "command": "rm",
      "args": [
        "-rf",
        "--",
        "build/native_sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "sample",
      "type": "promptString",
      "description": "Sample directory, relative to the repository",
      "default": "samples/hello_crux"
    }
  ]
}
