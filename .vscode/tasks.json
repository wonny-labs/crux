{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Build firmware (application, -Og)",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi",
        "--app",
        "${input:cruxApplication}",
        "--debug-optimizations"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Clean firmware",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -f \"$1/provenance.json\" && cmake --build \"$1\" --target clean",
        "_",
        "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "clean",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board container: start GDB Server",
      "detail": "Board Dev Container only: J-Link GDB Server through west, on port 2331",
      "type": "process",
      "command": "west",
      "args": [
        "debugserver",
        "-d",
        "build/zephyr/mimxrt1060_evk_B_qspi",
        "-r",
        "jlink",
        "--speed",
        "400"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "jlink-gdb-server",
        "pattern": {
          "regexp": "^ERROR: (.*)$",
          "message": 1
        },
        "background": {
          "activesBegin": true,
          "beginsPattern": "SEGGER J-Link GDB Server",
          "endsPattern": "Waiting for GDB connection"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Board container: build and start GDB Server",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build firmware",
        "Board container: start GDB Server"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cruxApplication",
      "type": "promptString",
      "description": "Application directory, relative to the repository",
      "default": "samples/time/clock_shell"
    }
  ]
}
