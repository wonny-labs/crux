{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Build firmware (application, -Og)",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi",
        "--app",
        "${input:cruxApplication}",
        "--debug-optimizations"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Clean firmware",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -f \"$1/provenance.json\" && cmake --build \"$1\" --target clean",
        "_",
        "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "clean",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Host: run_clock_shell",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "host-debug",
        "--target",
        "run_clock_shell"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Host: run_echo_client",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "host-debug",
        "--target",
        "run_echo_client"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Board: Build and flash (west flash)",
      "type": "process",
      "command": "west",
      "args": [
        "flash",
        "-d",
        "build/zephyr/mimxrt1060_evk_B_qspi",
        "-r",
        "jlink"
      ],
      "dependsOn": "Build firmware",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "cruxApplication",
      "type": "promptString",
      "description": "Application directory, relative to the repository",
      "default": "samples/time/clock_shell"
    }
  ]
}
