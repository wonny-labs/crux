{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Build firmware (application, -Og)",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-debug-target.sh",
      "args": [
        "mimxrt1060_evk@B//qspi",
        "--app",
        "${input:cruxApplication}",
        "--debug-optimizations"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Clean firmware",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -f \"$1/provenance.json\" && cmake --build \"$1\" --target clean",
        "_",
        "${workspaceFolder}/build/zephyr/mimxrt1060_evk_B_qspi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "clean",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Host: run_hello_crux",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "set -e; cmake -S samples/hello_crux/host -B build/samples/hello_crux_host -G Ninja -DCRUX_SOURCE_DIR=\"$PWD\"; cmake --build build/samples/hello_crux_host --target run_hello_crux"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Host: run_clock_shell",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "host-debug",
        "--target",
        "run_clock_shell"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Host: run_echo_client",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "host-debug",
        "--target",
        "run_echo_client"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    },
    {
      "label": "Board: Build and flash (west flash)",
      "type": "process",
      "command": "west",
      "args": [
        "flash",
        "-d",
        "build/zephyr/mimxrt1060_evk_B_qspi",
        "-r",
        "jlink"
      ],
      "dependsOn": "Build firmware",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Board: Build and flash a sample (west flash)",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "set -e; app=$1; build=build/$(basename \"$app\")_evkb; west build -p always -b 'mimxrt1060_evk@B//qspi' -d \"$build\" \"$app\"; west flash -d \"$build\" -r jlink",
        "_",
        "${input:boardSample}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "boardSample",
      "type": "pickString",
      "description": "Sample to build for the MIMXRT1060-EVKB and flash with the J-Link runner",
      "options": [
        "samples/hello_crux",
        "samples/time/clock_shell"
      ],
      "default": "samples/hello_crux"
    },
    {
      "id": "cruxApplication",
      "type": "promptString",
      "description": "Application directory, relative to the repository",
      "default": "samples/time/clock_shell"
    }
  ]
}
