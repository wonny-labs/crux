#
# Hand-written subset of a resolved .config of the MCUboot image of the RT1060-EVK Rev B
# composition (RAM load with revert). It is NOT a copy of a build output: it holds the
# options that scripts/check-boot-config.py reads, in the Kconfig output format, plus a few
# neighbours. Option names: see the docstring of tests/build/test_check_boot_config.py.
#
CONFIG_MCUBOOT=y
CONFIG_BOOT_RAM_LOAD=y
CONFIG_BOOT_RAM_LOAD_REVERT=y
CONFIG_BOOT_SIGNATURE_TYPE_ECDSA_P256=y
CONFIG_BOOT_IMAGE_EXECUTABLE_RAM_START=0x80000000
CONFIG_BOOT_IMAGE_EXECUTABLE_RAM_SIZE=33554432
# CONFIG_BOOT_VERSION_CMP_USE_BUILD_NUMBER is not set
# CONFIG_BOOT_SWAP_USING_MOVE is not set
# CONFIG_BOOT_DIRECT_XIP is not set
CONFIG_BOOT_SHARE_DATA=y
