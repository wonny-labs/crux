#
# Hand-written subset of a resolved .config of the application image of the RT1060-EVK Rev B
# composition (RAM load with revert). It is NOT a copy of a build output: it holds the
# options that scripts/check-boot-config.py reads, plus a few neighbours.
#
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_MCUBOOT_BOOTLOADER_MODE_RAM_LOAD_WITH_REVERT=y
# CONFIG_MCUBOOT_BOOTLOADER_MODE_RAM_LOAD is not set
# CONFIG_MCUBOOT_BOOTLOADER_MODE_SWAP_USING_OFFSET is not set
CONFIG_MCUBOOT_BOOTLOADER_NO_DOWNGRADE=y
CONFIG_MCUBOOT_GENERATE_CONFIRMED_IMAGE=y
# CONFIG_XIP is not set
CONFIG_RETENTION_BOOTLOADER_INFO_TYPE_MCUBOOT=y
