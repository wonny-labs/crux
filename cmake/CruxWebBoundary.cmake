include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CruxConsumerBoundary.cmake")

# The same rule as cmake/CruxAccessBoundary.cmake and CruxCredentialBoundary.cmake, for the headers of
# components/web that are private to a composition: adapter/ (the exchange API and the request head),
# session/, management/ and assets/. cmake/CruxConsumerBoundary.cmake refuses the src, ports, host, zephyr
# and tests directories of a component, but names none of these four (ADR-0004 section 1.3). The
# composition-only target crux_web_adapter links adapter/ on purpose, and a service links it privately,
# which CMake records as $<LINK_ONLY:...> and which carries no include directory, so a check by target
# name would wrongly fail it. This asks what matters: can one of these directories reach the consumer's
# compilation?
function(_crux_web_check_directories target property)
    get_target_property(requirements "${target}" "${property}")
    if(NOT requirements OR requirements MATCHES "-NOTFOUND$")
        return()
    endif()
    set(internal_dirs)
    foreach(name IN ITEMS adapter session management assets)
        set(internal_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../components/web/${name}")
        cmake_path(NORMAL_PATH internal_dir)
        list(APPEND internal_dirs "${internal_dir}")
    endforeach()
    _crux_consumer_values(values "${requirements}")
    foreach(value IN LISTS values)
        # A compile option can name a directory too.
        if(property MATCHES "COMPILE_OPTIONS$")
            if(NOT value MATCHES "^(SHELL:)?(-I|-isystem|-iquote)[ ]*(.+)$")
                continue()
            endif()
            set(value "${CMAKE_MATCH_3}")
        endif()
        if(NOT IS_ABSOLUTE "${value}")
            continue()
        endif()
        foreach(internal_dir IN LISTS internal_dirs)
            # The directory itself or below it, or a parent from which the header resolves by a longer
            # include path such as <adapter/crux_web_adapter.h>.
            cmake_path(IS_PREFIX internal_dir "${value}" NORMALIZE below)
            cmake_path(IS_PREFIX value "${internal_dir}" NORMALIZE above)
            if(below OR above)
                message(FATAL_ERROR "Web internal header reachable by a consumer: "
                                    "${target} ${property}: ${value}")
            endif()
        endforeach()
    endforeach()
endfunction()

# CMake propagates usage requirements through INTERFACE_LINK_LIBRARIES, except through LINK_ONLY.
function(_crux_web_walk target visited)
    get_target_property(real_target "${target}" ALIASED_TARGET)
    if(NOT real_target)
        set(real_target "${target}")
    endif()
    if("${real_target}" IN_LIST visited)
        set(_crux_web_visited "${visited}" PARENT_SCOPE)
        return()
    endif()
    list(APPEND visited "${real_target}")
    _crux_web_check_directories("${real_target}" INTERFACE_INCLUDE_DIRECTORIES)
    _crux_web_check_directories("${real_target}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    _crux_web_check_directories("${real_target}" INTERFACE_COMPILE_OPTIONS)
    foreach(property IN ITEMS INTERFACE_LINK_LIBRARIES INTERFACE_LINK_LIBRARIES_DIRECT)
        get_target_property(libraries "${real_target}" "${property}")
        if(NOT libraries OR libraries MATCHES "-NOTFOUND$")
            continue()
        endif()
        string(REGEX REPLACE "\\$<LINK_ONLY:[^<>]*>" "" libraries "${libraries}")
        _crux_consumer_values(values "${libraries}")
        foreach(value IN LISTS values)
            if(TARGET "${value}")
                _crux_web_walk("${value}" "${visited}")
                set(visited "${_crux_web_visited}")
            endif()
        endforeach()
    endforeach()
    set(_crux_web_visited "${visited}" PARENT_SCOPE)
endfunction()

# Call for public targets and consumers after the composition has declared its targets.
function(crux_assert_web_internal_unreachable)
    foreach(target IN LISTS ARGN)
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "unknown consumer target: ${target}")
        endif()
        _crux_web_walk("${target}" "")
    endforeach()
endfunction()

# A designated consumer's own PRIVATE requirements must not name these directories either.
function(crux_assert_web_consumer)
    foreach(target IN LISTS ARGN)
        crux_assert_web_internal_unreachable("${target}")
        get_target_property(type "${target}" TYPE)
        if(type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        _crux_web_check_directories("${target}" INCLUDE_DIRECTORIES)
        _crux_web_check_directories("${target}" COMPILE_OPTIONS)
        get_target_property(libraries "${target}" LINK_LIBRARIES)
        if(NOT libraries OR libraries MATCHES "-NOTFOUND$")
            continue()
        endif()
        string(REGEX REPLACE "\\$<LINK_ONLY:[^<>]*>" "" libraries "${libraries}")
        _crux_consumer_values(values "${libraries}")
        foreach(value IN LISTS values)
            if(TARGET "${value}")
                _crux_web_walk("${value}" "")
            endif()
        endforeach()
    endforeach()
endfunction()
