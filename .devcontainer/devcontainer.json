{
  "name": "Crux Pilot (Ubuntu 24.04 amd64)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--platform=linux/amd64"],
    "args": {
      "CRUX_JLINK": "auto",
      "CRUX_JLINK_DEB": "",
      "CRUX_JLINK_DEB_SHA256": "",
      "CRUX_JLINK_URL": ""
    }
  },
  "runArgs": [
    "--platform=linux/amd64",
    "--memory=4g",
    "--cpus=2",
    "--device-cgroup-rule=c 189:* rmw",
    "-v",
    "/dev/bus/usb:/dev/bus/usb"
  ],
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspace,type=bind",
  "workspaceFolder": "/workspace/crux-pilot",
  "mounts": [
    "source=crux-host-cache,target=/opt/crux-cache,type=volume"
  ],
  "containerEnv": {
    "CRUX_WORKSPACE": "/workspace",
    "CRUX_REPO": "/workspace/crux-pilot",
    "CRUX_CACHE_DIR": "/opt/crux-cache",
    "CRUX_BOOTSTRAP": "${localEnv:CRUX_BOOTSTRAP:all}",
    "ZEPHYR_SDK_INSTALL_DIR": "/opt/crux-cache/sdk/zephyr-sdk-1.0.1",
    "CLANG_FORMAT": "clang-format"
  },
  "postCreateCommand": "bash scripts/bootstrap.sh --keep-going",
  "postAttachCommand": "bash scripts/bootstrap.sh status",
  "remoteEnv": {
    "PATH": "/opt/crux-cache/venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-python.python",
        "redhat.vscode-yaml",
        "Arm.vscode-cmsis-debugger",
        "llvm-vs-code-extensions.vscode-clangd",
        "marus25.cortex-debug"
      ]
    }
  },
  "remoteUser": "vscode",
  "shutdownAction": "stopContainer"
}
